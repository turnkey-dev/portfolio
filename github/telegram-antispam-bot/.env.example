# Создайте бота через @BotFather и вставьте токен только в локальный .env.
BOT_TOKEN=PASTE_TOKEN_HERE
# false = удаление и бессрочный бан; true = только запись срабатываний в журнал.
DRY_RUN=false
# Порог: 7 стандартный; 9 мягче; 6 строже. Перезапустите бота после изменения.
SPAM_THRESHOLD=7
# ID групп через запятую. Пусто = все группы, в которые добавлен бот.
# Узнать ID можно командой /chatid в группе.
ALLOWED_CHAT_IDS=
# Пользователи, которых не нужно проверять, по числовому ID через запятую.
WHITELIST_USER_IDS=
